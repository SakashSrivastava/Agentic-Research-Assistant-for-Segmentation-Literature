# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Anthropic API key for Claude (LLM calls: metadata enrichment, agents).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Contact email sent in the User-Agent to arXiv / PubMed Central APIs.
# These services ask for a contact address so they can reach you if your
# script misbehaves. Use your real email.
CONTACT_EMAIL=you@example.com
