# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Groq API key (free tier) for LLM calls: metadata enrichment, agents.
# Get one free at https://console.groq.com/keys  (starts with "gsk_")
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Contact email sent in the User-Agent to arXiv / PubMed Central APIs.
# These services ask for a contact address so they can reach you if your
# script misbehaves. Use your real email.
CONTACT_EMAIL=you@example.com

# --- Web app (accounts + dashboards) ---
# Default target for `python -m src.manage_admin grant` (the ONLY way to become
# admin). Signup always creates a regular user, so this is not a backdoor: nobody
# can self-assign admin through the website. Set it to your email for convenience.
ADMIN_EMAIL=you@example.com
# Signs session cookies. Set to a fixed random string in production, or sessions
# reset on every restart. Generate one with: python -c "import secrets;print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-long-random-string
# Optional: path to the writable user database (accounts + history). Defaults to
# data/users.db locally. In prod, point this at a persistent writable volume.
# USER_DB_PATH=/app/userdata/users.db

# --- Security / deployment ---
SESSION_HOURS=12                     # idle session lifetime before re-login
REQUIRE_EMAIL_VERIFICATION=true      # new users must verify their email to log in
HTTPS_ONLY=false                     # set true in production: forces HTTPS + HSTS + secure cookies
BASE_URL=http://localhost:5000       # public origin, used to build email links
FREE_DAILY_QUERIES=5                 # shared-key searches/user/day before BYOK is required
MAX_QUESTION_CHARS=2000              # max length of a submitted question

# Optional SMTP for verification / password-reset emails. If left unset, the app
# runs in dev mode: it shows the link in-app and logs it (no real email is sent).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=you@example.com
