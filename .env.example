# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Groq API key (free tier) for LLM calls: metadata enrichment, agents.
# Get one free at https://console.groq.com/keys  (starts with "gsk_")
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Contact email sent in the User-Agent to arXiv / PubMed Central APIs.
# These services ask for a contact address so they can reach you if your
# script misbehaves. Use your real email.
CONTACT_EMAIL=you@example.com
